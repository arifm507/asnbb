@model AllamaShibliQuiz.Models.ViewModels.StudentViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/inner-pages.css" asp-append-version="true" />
}

<section class="ip-section">
    <div class="container">

        <!-- Page title -->
        <div class="ip-page-title">
            <nav class="ip-breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <i class="bi bi-chevron-right"></i>
                <a asp-controller="Register" asp-action="Index">Register</a>
                <i class="bi bi-chevron-right"></i>
                <span>Success</span>
            </nav>
            <div class="ip-page-title-row">
                <div class="ip-page-title-icon"><i class="bi bi-check2-circle"></i></div>
                <div>
                    <h1>Registration Submitted</h1>
                    <p>ASNBB 2026 &nbsp;·&nbsp; @Model.Name</p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">

                @if (Model.Status == 0)
                {
                    <!-- Action-required hero card -->
                    <div class="rs-action-card">
                        <div class="rs-action-header">
                            <div class="rs-action-badge">
                                <i class="bi bi-exclamation-triangle-fill"></i> Action Required
                            </div>
                            <h2>Complete Your Payment to Confirm Registration</h2>
                            <p>
                                You're almost there, <strong>@Model.Name</strong>! Your slot is reserved but
                                <strong>not confirmed</strong> until we receive your payment of
                                <span class="rs-amount">Rs. 70/-</span>.
                            </p>
                        </div>

                        <div class="rs-action-body">
                            <!-- QR + UPI ID -->
                            <div class="rs-qr-side">
                                <div class="rs-qr-label">Scan &amp; Pay</div>
                                <img src="~/assets/img/upi.jpeg" alt="UPI QR Code" class="rs-qr-img" />
                                <div class="rs-upi-id">
                                    <i class="bi bi-phone-fill"></i>
                                    <span>9793215638@ybl</span>
                                    <button class="rs-copy-btn" onclick="copyUpi(this)" data-upi="9793215638@ybl">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                                <div class="rs-upi-apps">
                                    <span>GPay</span><span>PhonePe</span><span>Paytm</span>
                                </div>
                            </div>

                            <!-- Steps -->
                            <div class="rs-steps-side">
                                <div class="rs-step">
                                    <div class="rs-step-num">1</div>
                                    <div>
                                        <h5>Pay Rs. 70/-</h5>
                                        <p>Scan the QR code or use the UPI ID with any payment app.</p>
                                    </div>
                                </div>
                                <div class="rs-step-divider"></div>
                                <div class="rs-step">
                                    <div class="rs-step-num">2</div>
                                    <div>
                                        <h5>Send Payment Screenshot</h5>
                                        <p>Share the transaction screenshot on WhatsApp for quick verification.</p>
                                        <div class="rs-wa-btns">
                                            <a href="https://wa.me/919236408638" target="_blank" class="rs-wa-btn">
                                                <i class="bi bi-whatsapp"></i> 9236408638
                                            </a>
                                            <a href="https://wa.me/917408840781" target="_blank" class="rs-wa-btn">
                                                <i class="bi bi-whatsapp"></i> 7408840781
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="rs-step-divider"></div>
                                <div class="rs-step">
                                    <div class="rs-step-num rs-step-num-ok">3</div>
                                    <div>
                                        <h5>Seat Confirmed</h5>
                                        <p>Our team will verify and confirm your registration. You can then download your admit card.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Already paid: show plain success banner -->
                    <div class="rs-success-banner">
                        <div class="rs-success-icon">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <div>
                            <h2>You're all set, <span>@Model.Name</span>!</h2>
                            <p>Your registration for ASNBB 2026 has been confirmed. Keep an eye on our website for admit card details.</p>
                        </div>
                    </div>
                }

                <!-- Actions -->
                <div class="d-flex gap-3 mt-4 flex-wrap">
                    <a asp-controller="Register" asp-action="Verify" class="ip-btn-primary">
                        <i class="bi bi-search"></i> Check Registration Status
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="ip-btn-ghost">
                        <i class="bi bi-house"></i> Back to Home
                    </a>
                </div>

            </div>
        </div>
    </div>
</section>

<style>
/* ── Action-required hero ───────────────────────────── */
.rs-action-card {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(245,158,11,.18);
    border: 1.5px solid #fcd34d;
}
.rs-action-header {
    background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
    padding: 28px 32px 24px;
    border-bottom: 1.5px solid #fde68a;
}
.rs-action-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #f59e0b;
    color: #fff;
    font-size: .75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .6px;
    padding: 5px 14px;
    border-radius: 50px;
    margin-bottom: 14px;
}
.rs-action-header h2 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #92400e;
    margin: 0 0 8px;
    line-height: 1.3;
}
.rs-action-header p {
    font-size: .92rem;
    color: #b45309;
    margin: 0;
    line-height: 1.55;
}
.rs-amount {
    background: #f59e0b;
    color: #fff;
    font-weight: 800;
    padding: 1px 10px;
    border-radius: 50px;
    font-size: .9rem;
    white-space: nowrap;
    display: inline-block;
}

/* Body: QR left, steps right */
.rs-action-body {
    background: #fff;
    padding: 28px 32px;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 36px;
    align-items: start;
}

/* QR side */
.rs-qr-side { text-align: center; }
.rs-qr-label {
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .5px;
    color: var(--ip-muted);
    margin-bottom: 10px;
}
.rs-qr-img {
    width: 100%;
    max-width: 180px;
    border-radius: 14px;
    border: 2px solid #fde68a;
    box-shadow: 0 4px 18px rgba(0,0,0,.1);
}
.rs-upi-id {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #f0fdf4;
    border: 1px solid #6ee7b7;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: .8rem;
    font-weight: 700;
    color: var(--ip-navy);
    margin-top: 12px;
}
.rs-upi-id i { color: var(--ip-green); }
.rs-copy-btn {
    background: none;
    border: none;
    color: var(--ip-green);
    cursor: pointer;
    padding: 0;
    font-size: .82rem;
    transition: color .2s;
}
.rs-copy-btn:hover { color: #059669; }
.rs-upi-apps {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
    flex-wrap: wrap;
}
.rs-upi-apps span {
    font-size: .68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .4px;
    color: var(--ip-muted);
    background: #f4f7fb;
    border: 1px solid var(--ip-border);
    padding: 3px 9px;
    border-radius: 50px;
}

/* Steps side */
.rs-steps-side { display: flex; flex-direction: column; gap: 0; }
.rs-step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
}
.rs-step-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f59e0b;
    color: #fff;
    font-size: .85rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.rs-step-num-ok { background: var(--ip-green); }
.rs-step h5 { font-size: .9rem; font-weight: 700; color: var(--ip-navy); margin: 0 0 4px; }
.rs-step p  { font-size: .83rem; color: var(--ip-muted); margin: 0; line-height: 1.5; }
.rs-step-divider {
    width: 2px;
    height: 20px;
    background: var(--ip-border);
    margin: 4px 0 4px 15px;
}

/* WhatsApp buttons */
.rs-wa-btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.rs-wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #25d366;
    color: #fff;
    font-weight: 700;
    padding: 9px 18px;
    border-radius: 50px;
    text-decoration: none;
    font-size: .85rem;
    transition: all .25s;
    box-shadow: 0 3px 12px rgba(37,211,102,.3);
}
.rs-wa-btn:hover { background: #20b858; color: #fff; transform: translateY(-2px); }

/* Plain success banner (already paid path) */
.rs-success-banner {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
    border: 1px solid #6ee7b7;
    border-radius: 20px;
    padding: 28px 30px;
    margin-bottom: 24px;
    box-shadow: 0 4px 20px rgba(16,185,129,.12);
}
.rs-success-icon {
    width: 60px; height: 60px; border-radius: 16px;
    background: linear-gradient(135deg, var(--ip-green), #059669);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem; color: #fff; flex-shrink: 0;
    box-shadow: 0 6px 20px rgba(16,185,129,.35);
}
.rs-success-banner h2 { font-size: 1.3rem; font-weight: 800; color: var(--ip-navy); margin: 0 0 6px; }
.rs-success-banner h2 span { color: var(--ip-green); }
.rs-success-banner p { color: #065f46; font-size: .92rem; margin: 0; line-height: 1.55; }

@@media (max-width: 767px) {
    .rs-action-body {
        grid-template-columns: 1fr;
        gap: 24px;
        padding: 20px 20px;
    }
    .rs-action-header { padding: 22px 20px 20px; }
    .rs-qr-img { max-width: 150px; }
    .rs-success-banner { flex-direction: column; gap: 14px; padding: 22px 20px; }
}
</style>

<script>
function copyUpi(btn) {
    navigator.clipboard.writeText(btn.dataset.upi).then(() => {
        var icon = btn.querySelector('i');
        icon.className = 'bi bi-check-lg';
        setTimeout(() => icon.className = 'bi bi-copy', 1800);
    });
}
</script>
