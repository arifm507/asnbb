@model AllamaShibliQuiz.Models.ViewModels.RegisterVerifyViewModel
@{
    ViewData["Title"] = "Verify ASNBB Registration | Allama Shibli Nomani Brainiac Battle";
    ViewData["MetaDescription"] = "Check your ASNBB Season 3 registration status with your mobile number or Aadhaar number.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/inner-pages.css" asp-append-version="true" />
}

<section class="ip-section">
    <div class="container">

        <!-- Compact title -->
        <div class="ip-page-title">
            <nav class="ip-breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <i class="bi bi-chevron-right"></i>
                <a asp-controller="Register" asp-action="Index">Register</a>
                <i class="bi bi-chevron-right"></i>
                <span>Verify</span>
            </nav>
            <div class="ip-page-title-row">
                <div class="ip-page-title-icon"><i class="bi bi-person-check-fill"></i></div>
                <div>
                    <h1>Verify Registration</h1>
                    <p>Check your ASNBB registration status instantly</p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="ip-card">

                    <div class="ip-card-header">
                        <div class="ip-card-icon"><i class="bi bi-search"></i></div>
                        <div>
                            <h3>Find Your Registration</h3>
                            <p>Enter the number used while registering</p>
                        </div>
                    </div>

                    <form asp-action="Verify" method="post" autocomplete="off" class="ip-form">
                        @Html.AntiForgeryToken()

                        <div class="ip-form-group">
                            <label class="ip-field-label">
                                Mobile Number / Aadhar Number
                                <span class="ip-required">*</span>
                            </label>
                            <div class="ip-search-wrap">
                                <i class="bi bi-search ip-search-icon"></i>
                                <input type="text" asp-for="SearchInput"
                                       class="ip-input ip-search-input"
                                       maxlength="12"
                                       onkeypress="return isNumber(event)"
                                       placeholder="10-digit mobile or 12-digit Aadhar"
                                       required />
                            </div>
                            <p class="ip-field-hint">
                                <i class="bi bi-shield-check" style="color:var(--ip-green)"></i>
                                Use the same number entered during registration
                            </p>
                        </div>

                        <div class="ip-form-actions">
                            <button type="submit" class="ip-btn-primary">
                                <i class="bi bi-search"></i> Verify Now
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="ip-btn-ghost">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>

                    <div class="ip-card-note">
                        <i class="bi bi-pencil-square-fill"></i>
                        Not registered yet? &nbsp;
                        <a asp-controller="Register" asp-action="Index"
                           style="color:var(--ip-green);font-weight:700">
                            Register here →
                        </a>
                    </div>

                </div>
            </div>
        </div>

    </div>
</section>
