@model AllamaShibliQuiz.Models.ViewModels.StudentViewModel
@{
    var today = DateTime.Now.ToString("yyyy-MM-dd");
    var hasError = ViewData["ValidateMessage"] != null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/inner-pages.css" asp-append-version="true" />
}

<section class="ip-section">
    <div class="container">

        <!-- Compact page title -->
        <div class="ip-page-title">
            <nav class="ip-breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <i class="bi bi-chevron-right"></i>
                <span>Registration</span>
            </nav>
            <div class="ip-page-title-row">
                <div class="ip-page-title-icon"><i class="bi bi-pencil-square"></i></div>
                <div>
                    <h1>Student Registration</h1>
                    <p>ASNBB &nbsp;·&nbsp; Enroll for the Brainiac Battle</p>
                </div>
                <a asp-controller="Register" asp-action="Verify" class="ip-verify-link ms-auto">
                    <i class="bi bi-search"></i> Verify Registration
                </a>
            </div>
        </div>

        <!-- Step indicators -->
        <div class="ip-stepper">
            <div class="ip-step-item active" id="ind-1">
                <div class="ip-step-circle" id="circle-1">1</div>
                <span class="ip-step-label">Personal</span>
            </div>
            <div class="ip-step-connector" id="conn-1"></div>
            <div class="ip-step-item" id="ind-2">
                <div class="ip-step-circle" id="circle-2">2</div>
                <span class="ip-step-label">Academic</span>
            </div>
            <div class="ip-step-connector" id="conn-2"></div>
            <div class="ip-step-item" id="ind-3">
                <div class="ip-step-circle" id="circle-3">3</div>
                <span class="ip-step-label">Contact</span>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-11">
                <div class="ip-card">

                    <!-- Progress bar -->
                    <div class="ip-progress-bar">
                        <div class="ip-progress-fill" id="progressFill" style="width:33%"></div>
                    </div>

                    <!-- Server-side error -->
                    @if (hasError)
                    {
                        <div class="ip-alert ip-alert-error" style="margin:20px 32px 0">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            @ViewData["ValidateMessage"]
                        </div>
                    }

                    <form asp-action="Index" method="post" autocomplete="off" id="register-form" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- ══ STEP 1 · Personal Details ══ -->
                        <div class="ip-form-step active" id="step-1">
                            <div class="ip-step-header">
                                <div class="ip-step-header-icon" style="background:linear-gradient(135deg,#1e3a5f,#00b4c8)">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div>
                                    <h3>Personal Details</h3>
                                    <p>Basic information about the student</p>
                                </div>
                            </div>
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label class="ip-field-label">Full Name <span class="ip-required">*</span></label>
                                    <input type="text" asp-for="Name" class="ip-input" placeholder="Enter student's full name" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="ip-field-label">Father's Name <span class="ip-required">*</span></label>
                                    <input type="text" asp-for="FatherName" class="ip-input" placeholder="Enter father's name" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="ip-field-label">Gender <span class="ip-required">*</span></label>
                                    <select asp-for="Gender" class="ip-select" required>
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="ip-field-label">Date of Birth</label>
                                    <input type="date" asp-for="DateOfBirth" class="ip-input" max="@today" />
                                </div>
                            </div>
                        </div>

                        <!-- ══ STEP 2 · Academic Details ══ -->
                        <div class="ip-form-step" id="step-2">
                            <div class="ip-step-header">
                                <div class="ip-step-header-icon" style="background:linear-gradient(135deg,#10b981,#059669)">
                                    <i class="bi bi-book-fill"></i>
                                </div>
                                <div>
                                    <h3>Academic Details</h3>
                                    <p>Class, school and exam centre information</p>
                                </div>
                            </div>
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label class="ip-field-label">Class <span class="ip-required">*</span></label>
                                    <select id="class" asp-for="Class" class="ip-select" required>
                                        <option value="">Select Class</option>
                                        <option value="6">Class 6</option>
                                        <option value="7">Class 7</option>
                                        <option value="8">Class 8</option>
                                        <option value="9">Class 9</option>
                                        <option value="10">Class 10</option>
                                        <option value="11">Class 11</option>
                                        <option value="12">Class 12</option>
                                    </select>
                                    <div id="subjectDrpdown" style="display:none" class="mt-3">
                                        <label class="ip-field-label">Subject (Science Stream)</label>
                                        <select id="subject" asp-for="Subject" class="ip-select">
                                            <option value="">Select Subject</option>
                                            <option value="Bio">Biology</option>
                                            <option value="Maths">Maths</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="ip-field-label">School Name <span class="ip-required">*</span></label>
                                    <select id="school" asp-for="SchoolId" class="ip-select"
                                            asp-items="@(new SelectList(ViewBag.Schools, "Id", "Name"))" required>
                                        <option value="">Select School</option>
                                    </select>
                                    <input type="text" id="otherSchoolName" asp-for="OtherSchoolName"
                                           class="ip-input mt-3" placeholder="Type school name" style="display:none" />
                                </div>
                                <div class="col-md-6" id="examcentre-div">
                                    <label class="ip-field-label">Exam Centre <span class="ip-required">*</span></label>
                                    <select id="examcentre" asp-for="ExamCentreId" class="ip-select"
                                            asp-items="@(new SelectList(ViewBag.ExamCentres, "Id", "Name"))">
                                        <option value="">Select Exam Centre</option>
                                    </select>
                                    <input type="hidden" asp-for="ExamCentreId" id="examcentre-hidden" />
                                </div>
                                <div class="col-md-6" id="optionalSubjectDiv" style="display:none">
                                    <label class="ip-field-label">Optional Subject <span class="ip-required">*</span></label>
                                    <select id="optionalSubject" asp-for="OptionalSubject" class="ip-select">
                                        <option value="">Select Optional Subject</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- ══ STEP 3 · Contact & Identity ══ -->
                        <div class="ip-form-step" id="step-3">
                            <div class="ip-step-header">
                                <div class="ip-step-header-icon" style="background:linear-gradient(135deg,#7c3aed,#5b21b6)">
                                    <i class="bi bi-shield-lock-fill"></i>
                                </div>
                                <div>
                                    <h3>Contact &amp; Identity</h3>
                                    <p>Address and verification details</p>
                                </div>
                            </div>

                            <div class="ip-aadhar-notice">
                                <i class="bi bi-info-circle-fill"></i>
                                <span>Enter a valid <strong>Aadhar Number</strong> (yours or your parent's). You will need it to download your admit card.</span>
                            </div>

                            <div class="row g-4 mt-1">
                                <div class="col-md-12">
                                    <label class="ip-field-label">Address <span class="ip-required">*</span></label>
                                    <input type="text" asp-for="Address" class="ip-input" placeholder="Village / Town, District, State" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="ip-field-label">Mobile Number (WhatsApp) <span class="ip-required">*</span></label>
                                    <input type="text" asp-for="MobileNumber" class="ip-input" id="mobile"
                                           maxlength="10" onkeypress="return isNumber(event)"
                                           placeholder="10-digit number" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="ip-field-label">Aadhar Number <span class="ip-required">*</span></label>
                                    <input type="text" asp-for="AadharNumber" class="ip-input" id="aadhar"
                                           maxlength="12" onkeypress="return isNumber(event)"
                                           placeholder="12-digit Aadhar number" required />
                                </div>
                            </div>
                        </div>

                        <!-- ══ Navigation Footer ══ -->
                        <div class="ip-step-nav">
                            <button type="button" class="ip-btn-ghost" id="prevBtn" style="display:none">
                                <i class="bi bi-arrow-left"></i> Back
                            </button>
                            <button type="button" class="ip-btn-primary" id="nextBtn">
                                Next &nbsp;<i class="bi bi-arrow-right"></i>
                            </button>
                            <button type="submit" class="ip-btn-primary" id="submitBtn" style="display:none">
                                <i class="bi bi-check-circle-fill"></i> Submit Registration
                            </button>
                            <span class="ip-step-counter" id="stepCounter">Step 1 of 3</span>
                        </div>
                    </form>
                </div>

                <p class="text-center mt-3" style="font-size:.83rem;color:#6b7080">
                    Already registered? &nbsp;
                    <a asp-controller="Register" asp-action="Verify" style="color:#10b981;font-weight:700">
                        Verify your registration →
                    </a>
                </p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    /* ── Wizard state ── */
    var currentStep = 1;
    var totalSteps  = 3;
    var goingBack   = false;

    var steps   = [1, 2, 3];
    var progPct = ['33%', '66%', '100%'];

    function showStep(n, back) {
        document.querySelectorAll('.ip-form-step').forEach(function (s) {
            s.classList.remove('active', 'slide-back');
        });
        var panel = document.getElementById('step-' + n);
        panel.classList.add('active');
        if (back) panel.classList.add('slide-back');

        // Progress bar
        document.getElementById('progressFill').style.width = progPct[n - 1];

        // Stepper indicators
        for (var i = 1; i <= totalSteps; i++) {
            var ind    = document.getElementById('ind-' + i);
            var circle = document.getElementById('circle-' + i);
            ind.classList.remove('active', 'done');
            if (i < n)       { ind.classList.add('done'); circle.innerHTML = '<i class="bi bi-check-lg"></i>'; }
            else if (i === n) { ind.classList.add('active'); circle.textContent = i; }
            else              { circle.textContent = i; }
        }
        // Connectors
        for (var j = 1; j < totalSteps; j++) {
            var conn = document.getElementById('conn-' + j);
            conn.classList.toggle('done', j < n);
        }

        // Nav buttons
        document.getElementById('prevBtn').style.display   = n > 1       ? '' : 'none';
        document.getElementById('nextBtn').style.display   = n < totalSteps ? '' : 'none';
        document.getElementById('submitBtn').style.display = n === totalSteps ? '' : 'none';
        document.getElementById('stepCounter').textContent = 'Step ' + n + ' of ' + totalSteps;
    }

    function validateStep(n) {
        var panel  = document.getElementById('step-' + n);
        var fields = panel.querySelectorAll('[required]');
        var valid  = true;
        fields.forEach(function (f) {
            f.classList.remove('ip-input-error');
            if (!f.value.trim()) {
                f.classList.add('ip-input-error');
                valid = false;
            }
        });
        return valid;
    }

    document.getElementById('nextBtn').addEventListener('click', function () {
        if (!validateStep(currentStep)) return;
        currentStep++;
        showStep(currentStep, false);
    });

    document.getElementById('prevBtn').addEventListener('click', function () {
        currentStep--;
        showStep(currentStep, true);
    });

    document.getElementById('register-form').addEventListener('submit', function (e) {
        if (!validateStep(currentStep)) {
            e.preventDefault();
        }
    });

    /* ── Existing school / class logic (preserved exactly) ── */
    function verifyExamCenter(schoolId) {
        var examCenter = document.getElementById('examcentre');
        var hidden     = document.getElementById('examcentre-hidden');
        if (schoolId === '' || schoolId === '0') {
            examCenter.value    = '';
            examCenter.required = true;
            hidden.value        = '';
            document.getElementById('examcentre-div').style.display = '';
        } else {
            examCenter.value    = schoolId;
            examCenter.required = false;
            hidden.value        = schoolId;
            document.getElementById('examcentre-div').style.display = 'none';
        }
    }

    var schoolDropdown = document.getElementById('school');
    if (schoolDropdown) {
        verifyExamCenter(schoolDropdown.value);
        schoolDropdown.addEventListener('change', function (e) {
            var id = e.target.value;
            document.getElementById('otherSchoolName').style.display = (id === '0') ? '' : 'none';
            verifyExamCenter(id);
        });
    }

    var classDropdown = document.getElementById('class');
    if (classDropdown) {
        var subjectDiv          = document.getElementById('subjectDrpdown');
        var optionalSubjectDiv  = document.getElementById('optionalSubjectDiv');
        var optionalSubjectSel  = document.getElementById('optionalSubject');

        var optionalSubjectOptions = {
            '6':  ['Islamic Studies', 'Sports'],
            '7':  ['Islamic Studies', 'Sports'],
            '8':  ['Islamic Studies', 'Sports'],
            '9':  ['Islamic Studies', 'UP History'],
            '10': ['Islamic Studies', 'UP History'],
            '11': ['Islamic Studies', 'UP History'],
            '12': ['Islamic Studies', 'UP History']
        };

        function toggleSubject(val) {
            subjectDiv.style.display = (val === '11' || val === '12') ? '' : 'none';
        }

        function updateOptionalSubject(val) {
            var opts = optionalSubjectOptions[val];
            if (opts) {
                var existing = optionalSubjectSel.value;
                optionalSubjectSel.innerHTML = '<option value="">Select Optional Subject</option>';
                opts.forEach(function (o) {
                    var opt = document.createElement('option');
                    opt.value = o;
                    opt.textContent = o;
                    if (o === existing) opt.selected = true;
                    optionalSubjectSel.appendChild(opt);
                });
                optionalSubjectDiv.style.display  = '';
                optionalSubjectSel.required = true;
            } else {
                optionalSubjectDiv.style.display  = 'none';
                optionalSubjectSel.required = false;
                optionalSubjectSel.value = '';
            }
        }

        toggleSubject(classDropdown.value);
        updateOptionalSubject(classDropdown.value);
        classDropdown.addEventListener('change', function (e) {
            toggleSubject(e.target.value);
            updateOptionalSubject(e.target.value);
        });
    }

    /* ── Error-state highlight ── */
    document.querySelectorAll('.ip-input, .ip-select').forEach(function (el) {
        el.addEventListener('input', function () { el.classList.remove('ip-input-error'); });
    });

    /* ── If page reloaded with server error, jump to step 2 ── */
    @if (hasError)
    {
        <text>
        currentStep = 2;
        showStep(2, false);
        </text>
    }
</script>
}
