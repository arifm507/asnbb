@section Scripts {
@{
    var seoBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Event",
  "name": "Allama Shibli Nomani Brainiac Battle Season 3",
  "description": "Offline OMR quiz for Class 6th–12th students in Azamgarh, Uttar Pradesh. Registration is open 1–31 October 2026.",
  "startDate": "2026-11-21",
  "endDate": "2026-11-22",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "url": "@seoBase/",
  "image": "@seoBase/assets/img/logo.png",
  "location": {
    "@@type": "Place",
    "name": "Azamgarh, Uttar Pradesh",
    "address": {
      "@@type": "PostalAddress",
      "streetAddress": "Village and Post Kotila",
      "addressLocality": "Azamgarh",
      "addressRegion": "Uttar Pradesh",
      "postalCode": "276207",
      "addressCountry": "IN"
    }
  },
  "organizer": {
    "@@type": "Organization",
    "name": "Team Brainiac Battle",
    "url": "@seoBase/"
  }
}
</script>
<!-- FAQ structured data for SEO -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "FAQPage",
  "mainEntity": [
    { "@@type": "Question", "name": "When will the quiz examination happen?", "acceptedAnswer": { "@@type": "Answer", "text": "Season 2 was successfully held in November 2024. Season 3 exam will be held on 21 & 22 November 2026. Registration is open from 01 Oct to 31 Oct 2026." } },
    { "@@type": "Question", "name": "Which class students can participate?", "acceptedAnswer": { "@@type": "Answer", "text": "Students from Class 6th to 12th can participate in the quiz competition." } },
    { "@@type": "Question", "name": "What will be the medium of the paper?", "acceptedAnswer": { "@@type": "Answer", "text": "The exam will be based on English medium following the CBSE pattern." } },
    { "@@type": "Question", "name": "Will it be online or offline?", "acceptedAnswer": { "@@type": "Answer", "text": "It is a Pen-Paper (OMR) based offline examination held at 4-5 exam centres in Azamgarh, UP." } },
    { "@@type": "Question", "name": "How do I register and participate?", "acceptedAnswer": { "@@type": "Answer", "text": "Fill the registration form on this website and send the registration fee via UPI to the number provided on the registration page. After successful verification you will receive your admit card and exam centre details." } }
  ]
}
</script>
<script>
    // ── Countdown to registration deadline ──────────────
    (function () {
        var el = document.getElementById('regCountdown');
        if (!el) return;
        var deadline = new Date(el.dataset.deadline).getTime();
        var nums = {
            days:  el.querySelector('[data-cd="days"]'),
            hours: el.querySelector('[data-cd="hours"]'),
            mins:  el.querySelector('[data-cd="mins"]'),
            secs:  el.querySelector('[data-cd="secs"]')
        };
        var pad = function (n) { return (n < 10 ? '0' : '') + n; };
        function tick() {
            var diff = deadline - Date.now();
            if (diff <= 0) {
                el.innerHTML = '<div class="h2-countdown-label"><i class="bi bi-lock-fill"></i> Registration for Season 3 is now closed</div>';
                clearInterval(timer);
                return;
            }
            var d = Math.floor(diff / 86400000);
            var h = Math.floor(diff % 86400000 / 3600000);
            var m = Math.floor(diff % 3600000 / 60000);
            var s = Math.floor(diff % 60000 / 1000);
            nums.days.textContent  = pad(d);
            nums.hours.textContent = pad(h);
            nums.mins.textContent  = pad(m);
            nums.secs.textContent  = pad(s);
        }
        tick();
        var timer = setInterval(tick, 1000);
    })();

    // ── Animated count-up for stats ─────────────────────
    (function () {
        var counters = document.querySelectorAll('.h2-count');
        if (!counters.length || !('IntersectionObserver' in window)) {
            counters.forEach(function (c) { c.textContent = c.dataset.count; });
            return;
        }
        var run = function (c) {
            var target = parseInt(c.dataset.count, 10);
            var start = null, dur = 1600;
            function step(ts) {
                if (!start) start = ts;
                var p = Math.min((ts - start) / dur, 1);
                c.textContent = Math.floor(p * target).toLocaleString();
                if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        };
        var obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) { run(e.target); obs.unobserve(e.target); }
            });
        }, { threshold: 0.4 });
        counters.forEach(function (c) { obs.observe(c); });
    })();

    document.querySelectorAll('.h2-faq-q').forEach(function (q) {
        q.addEventListener('click', function () {
            var item = q.parentElement;
            var wasOpen = item.classList.contains('open');
            document.querySelectorAll('.h2-faq').forEach(function (f) { f.classList.remove('open'); });
            if (!wasOpen) item.classList.add('open');
        });
    });
    document.querySelectorAll('.h2-filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.h2-filter-btn').forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
            var filter = btn.dataset.filter;
            document.querySelectorAll('.h2-gallery-item').forEach(function (item) {
                item.style.display = (filter === 'all' || item.dataset.category === filter) ? '' : 'none';
            });
        });
    });
</script>
}
