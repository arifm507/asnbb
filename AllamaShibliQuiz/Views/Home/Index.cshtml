@{
    ViewData["Title"] = "Allama Shibli Nomani Brainiac Battle";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home2.css" asp-append-version="true" />
}

<!-- ═══════════════════════════════════════════════════
     HERO
══════════════════════════════════════════════════════ -->
<section class="h2-hero">
    <div class="container">
        <div class="row align-items-center">

            <!-- Left: Content -->
            <div class="col-lg-6 h2-hero-content" data-aos="fade-right">
                <div class="h2-hero-badge">
                    <span class="h2-dot"></span> Season 3 &nbsp;·&nbsp; Registration Open
                </div>
                <h1 class="h2-hero-title">
                    Allama Shibli Nomani<br>
                    <span>Brainiac Battle</span>
                </h1>
                <p class="h2-hero-season">ASNBB — Season 3 &nbsp;·&nbsp; Registration: 01 Oct – 31 Oct 2026</p>
                <p class="h2-hero-desc">
                    A premier quiz competition celebrating the legacy of one of India's greatest scholars.
                    Season 3 registration is now open — register before 31 Oct 2026. Exam on 21–22 Nov 2026.
                </p>
                <p class="h2-hero-org">
                    Organized by
                    <a href="https://www.instagram.com/shibli_brainiac_battle?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank">Team Brainiac Battle</a>
                    &nbsp;·&nbsp;
                    Sponsored by
                    <strong style="color:var(--h2-teal);font-weight:700">Moral Public School, Chittepur, Saraimeer</strong>
                </p>
                <div class="h2-hero-cta">
                    <a asp-controller="Home" asp-action="Register" class="h2-btn-primary">
                        <i class="bi bi-pencil-square"></i> Register Now
                    </a>
                    <a href="https://www.youtube.com/watch?v=e07NdiP2vCg" class="h2-btn-outline glightbox">
                        <i class="bi bi-play-circle-fill"></i> Watch Video
                    </a>
                </div>
                <div class="h2-hero-chips">
                    <div class="h2-hero-chip"><i class="bi bi-people-fill"></i> Class 6th – 12th</div>
                    <div class="h2-hero-chip"><i class="bi bi-geo-alt-fill"></i> Azamgarh, UP</div>
                    <div class="h2-hero-chip"><i class="bi bi-file-earmark-check-fill"></i> OMR / Pen-Paper</div>
                </div>
            </div>

            <!-- Right: Top Performers Card -->
            <div class="col-lg-6" data-aos="fade-left" data-aos-delay="150">
                <div class="h2-toppers-card">
                    <div class="h2-toppers-card-header">
                        <h5><i class="bi bi-star-fill me-2"></i>Top Performers — ASNBB 2024</h5>
                    </div>
                    <div class="h2-toppers-card-body">
                        <div class="swiper h2-toppers-swiper">
                            <script type="application/json" class="swiper-config">
                                {
                                  "loop": true, "speed": 700,
                                  "autoplay": { "delay": 1800 },
                                  "slidesPerView": 4,
                                  "spaceBetween": 10,
                                  "breakpoints": {
                                    "0":   { "slidesPerView": 2 },
                                    "480": { "slidesPerView": 3 },
                                    "768": { "slidesPerView": 4 }
                                  },
                                  "pagination": { "el": ".swiper-pagination", "clickable": true }
                                }
                            </script>
                            <div class="swiper-wrapper">
                                @for (int i = 1; i <= 27; i++)
                                {
                                    <div class="swiper-slide">
                                        <img src="~/assets/img/toppers24/@(i).jpeg" class="img-fluid" alt="Top Performer @i" />
                                    </div>
                                }
                            </div>
                            <div class="swiper-pagination mt-2"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════
     SEASON 3 ANNOUNCEMENT
══════════════════════════════════════════════════════ -->
<div class="h2-s3-bar">
    <div class="container">
        <div class="h2-s3-inner">
            <div class="h2-s3-badge">NEW</div>
            <p>
                <strong>Season 3 Registration is Open!</strong>
