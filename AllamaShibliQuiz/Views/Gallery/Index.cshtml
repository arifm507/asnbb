@{
    ViewData["Title"] = "ASNBB Gallery | Exam Day and Prize Distribution";
    ViewData["MetaDescription"] = "Photos from the Allama Shibli Nomani Brainiac Battle: exam day and prize distribution in Azamgarh.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/inner-pages.css" asp-append-version="true" />
}

@{
    // (image number, category)  prize = Prize Distribution,  exam = Exam Day
    var images = new (int Num, string Cat)[]
    {
        (1,"prize"),(2,"prize"),(18,"prize"),(3,"prize"),(33,"prize"),
        (4,"prize"),(22,"prize"),(5,"prize"),(6,"prize"),(31,"prize"),
        (7,"prize"),(8,"prize"),(9,"prize"),(10,"prize"),(11,"prize"),
        (12,"prize"),(13,"prize"),(14,"prize"),(15,"prize"),(16,"prize"),
        (49,"prize"),(17,"prize"),(19,"prize"),(20,"prize"),(21,"prize"),
        (23,"prize"),(24,"prize"),(25,"prize"),(26,"prize"),(27,"prize"),
        (28,"prize"),(29,"prize"),(30,"prize"),(32,"prize"),(34,"prize"),
        (35,"prize"),(36,"prize"),(37,"prize"),(38,"prize"),(39,"prize"),
        (40,"prize"),(50,"prize"),(51,"prize"),(52,"prize"),(53,"prize"),
        (41,"exam"),(42,"exam"),(43,"exam"),(44,"exam"),
        (45,"exam"),(46,"exam"),(47,"exam"),(48,"exam")
    };

    int total = images.Length;
    int examCount  = images.Count(x => x.Cat == "exam");
    int prizeCount = images.Count(x => x.Cat == "prize");
}

<section class="gal-section">
    <div class="container">

        <!-- Page title (dark variant) -->
        <div class="ip-page-title" style="margin-bottom:20px">
            <nav class="ip-breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <i class="bi bi-chevron-right"></i>
                <span>Gallery</span>
            </nav>
            <div class="ip-page-title-row">
                <div class="ip-page-title-icon"><i class="bi bi-images"></i></div>
                <div>
                    <h1>Image Gallery</h1>
                    <p>Memorable moments from ASNBB Season 3 &nbsp;·&nbsp; 2026</p>
                </div>
            </div>
        </div>

        <!-- Stats bar -->
        <div class="gal-stats">
            <div class="gal-stat">
                <i class="bi bi-images"></i>
                <span><strong>@total</strong> Photos</span>
            </div>
            <div class="gal-stat">
                <i class="bi bi-trophy-fill"></i>
                <span><strong>@prizeCount</strong> Prize Distribution</span>
            </div>
            <div class="gal-stat">
                <i class="bi bi-pencil-fill"></i>
                <span><strong>@examCount</strong> Exam Day</span>
            </div>
            <div class="gal-stat">
                <i class="bi bi-calendar3"></i>
                <span>Season 3 &nbsp;·&nbsp; <strong>2026</strong></span>
            </div>
        </div>

        <!-- Filter buttons -->
        <div class="gal-filters">
            <button class="gal-filter-btn active" data-filter="all">
                All Photos <span class="gal-count" id="cnt-all">@total</span>
            </button>
            <button class="gal-filter-btn" data-filter="prize">
                <i class="bi bi-trophy"></i> Prize Distribution
                <span class="gal-count" id="cnt-prize">@prizeCount</span>
            </button>
            <button class="gal-filter-btn" data-filter="exam">
                <i class="bi bi-pencil-square"></i> Exam Day
                <span class="gal-count" id="cnt-exam">@examCount</span>
            </button>
        </div>

        <!-- Masonry grid -->
        <div class="gal-grid" id="galGrid">
            @foreach (var img in images)
            {
                <div class="gal-item" data-cat="@img.Cat">
                    <img src="~/assets/img/portfolio/@(img.Num).jpeg"
                         alt="ASNBB @(img.Cat == "prize" ? "Prize Distribution" : "Exam Day")"
                         loading="lazy" />
                    <div class="gal-overlay">
                        <i class="bi bi-zoom-in"></i>
                    </div>
                    <a href="~/assets/img/portfolio/@(img.Num).jpeg"
                       data-gallery="asnbb-gallery"
                       class="glightbox"
                       style="position:absolute;inset:0"></a>
                </div>
            }
        </div>

    </div>
</section>

@section Scripts {
<script>
    var filterBtns = document.querySelectorAll('.gal-filter-btn');
    var items      = document.querySelectorAll('.gal-item');

    filterBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
            filterBtns.forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');

            var filter = btn.dataset.filter;
            items.forEach(function (item) {
                if (filter === 'all' || item.dataset.cat === filter) {
                    item.classList.remove('gal-hidden');
                } else {
                    item.classList.add('gal-hidden');
                }
            });
        });
    });
</script>
}
