@model AllamaShibliQuiz.Models.RequestModels.AdmitCardRequestModel

@section Styles {
    <link rel="stylesheet" href="~/css/inner-pages.css" asp-append-version="true" />
}

<section class="ip-section">
    <div class="container">

        <!-- Compact title -->
        <div class="ip-page-title">
            <nav class="ip-breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <i class="bi bi-chevron-right"></i>
                <span>Admit Card</span>
            </nav>
            <div class="ip-page-title-row">
                <div class="ip-page-title-icon"><i class="bi bi-card-text"></i></div>
                <div>
                    <h1>Download Admit Card</h1>
                    <p>ASNBB Season 2 &nbsp;·&nbsp; 2024</p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="ip-card">

                    <div class="ip-card-header">
                        <div class="ip-card-icon"><i class="bi bi-download"></i></div>
                        <div>
                            <h3>Find Your Admit Card</h3>
                            <p>Enter your mobile or Aadhar number</p>
                        </div>
                    </div>

                    <form asp-action="Index" method="post" autocomplete="off" class="ip-form">
                        @Html.AntiForgeryToken()

                        <div class="ip-form-group">
                            <label class="ip-field-label">
                                Mobile Number / Aadhar Number
                                <span class="ip-required">*</span>
                            </label>
                            <div class="ip-search-wrap">
                                <i class="bi bi-search ip-search-icon"></i>
                                <input type="text" asp-for="SearchInput"
                                       class="ip-input ip-search-input"
                                       maxlength="12"
                                       onkeypress="return isNumber(event)"
                                       placeholder="10-digit mobile or 12-digit Aadhar"
                                       required />
                            </div>
                            <p class="ip-field-hint">
                                <i class="bi bi-info-circle" style="color:var(--ip-green)"></i>
                                Only <strong>approved</strong> registrations can download admit cards
                            </p>
                        </div>

                        <div class="ip-form-actions">
                            <button type="submit" class="ip-btn-primary">
                                <i class="bi bi-download"></i> Get Admit Card
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="ip-btn-ghost">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>

                    <div class="ip-card-note">
                        <i class="bi bi-clock-fill"></i>
                        Not yet approved? Check your status at &nbsp;
                        <a asp-controller="Register" asp-action="Verify"
                           style="color:var(--ip-green);font-weight:700">
                            Verify Registration →
                        </a>
                    </div>

                </div>
            </div>
        </div>

    </div>
</section>
