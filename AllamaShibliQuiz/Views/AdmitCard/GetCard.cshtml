@model List<AllamaShibliQuiz.Models.ViewModels.StudentViewModel>

@section Styles {
    <link rel="stylesheet" href="~/css/inner-pages.css" asp-append-version="true" />
}

<section class="ip-section">
    <div class="container">

        <!-- Compact title -->
        <div class="ip-page-title">
            <nav class="ip-breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <i class="bi bi-chevron-right"></i>
                <a asp-controller="AdmitCard" asp-action="Index">Admit Card</a>
                <i class="bi bi-chevron-right"></i>
                <span>Download</span>
            </nav>
            <div class="ip-page-title-row">
                <div class="ip-page-title-icon"><i class="bi bi-card-text"></i></div>
                <div>
                    <h1>Your Admit Card(s)</h1>
                    <p>ASNBB Season 3 &nbsp;·&nbsp; 2026</p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9 col-md-11">

                <!-- Found banner -->
                <div class="ip-result-banner ip-result-banner-ok">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>
                        <strong>@Model.Count admit card(s) found</strong>
                        — click the button on each card to download.
                    </span>
                </div>

                <!-- Student cards -->
                <div class="ip-student-cards">
                    @foreach (var (item, index) in Model.Select((x, i) => (x, i + 1)))
                    {
                        var initials = string.Join("", item.Name.Split(' ').Take(2).Select(w => w[0])).ToUpper();

                        <div class="ip-student-card">
                            <div class="ip-student-avatar">@initials</div>

                            <div class="ip-student-info">
                                <h4>@item.Name</h4>
                                <p>Father: @item.FatherName</p>
                                <div class="ip-student-meta">
                                    <span><i class="bi bi-mortarboard-fill"></i> Class @item.Class</span>
                                    <span><i class="bi bi-building"></i> @item.SchoolName</span>
                                    @if (!string.IsNullOrEmpty(item.RollNumber))
                                    {
                                        <span>
                                            <i class="bi bi-hash"></i>
                                            Roll No: <strong style="color:var(--ip-navy)">@item.RollNumber</strong>
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="ip-student-right">
                                <span class="ip-badge ip-badge-approved">
                                    <i class="bi bi-check-circle-fill"></i> Approved
                                </span>
                                <a asp-action="ViewCard" asp-route-Id="@item.Id"
                                   class="ip-btn-primary" style="font-size:.82rem;padding:8px 18px">
                                    <i class="bi bi-download"></i> Download Card
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <!-- Actions -->
                <div class="d-flex gap-3 mt-4 flex-wrap">
                    <a asp-controller="AdmitCard" asp-action="Index" class="ip-btn-ghost">
                        <i class="bi bi-arrow-left"></i> Search Again
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="ip-btn-ghost">
                        <i class="bi bi-house"></i> Back to Home
                    </a>
                </div>

            </div>
        </div>

    </div>
</section>
