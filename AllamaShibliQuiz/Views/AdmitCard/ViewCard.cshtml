@{
    Layout = null;
}
@model AllamaShibliQuiz.Models.ViewModels.StudentViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admit Card — @Model.Name | ASNBB 2026</title>
    <meta name="robots" content="noindex, nofollow">
    <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <style>
        /* ── Screen styles ────────────────────────────── */
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: Arial, sans-serif;
            background: #f0f3f8;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            forced-color-adjust: auto !important;
        }

        /* Sticky toolbar */
        .vc-toolbar {
            background: linear-gradient(135deg, #0f2040 0%, #1e3a5f 100%);
            padding: 12px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 12px rgba(0,0,0,.25);
        }
        .vc-toolbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .vc-toolbar-brand img {
            width: 36px;
            border-radius: 8px;
        }
        .vc-toolbar-brand span {
            color: #fff;
            font-weight: 700;
            font-size: .92rem;
        }
        .vc-toolbar-brand small {
            display: block;
            color: rgba(255,255,255,.5);
            font-size: .72rem;
            font-weight: 400;
        }
        .vc-toolbar-actions { display: flex; gap: 10px; }

        .vc-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 20px;
            border-radius: 50px;
            font-size: .83rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            border: none;
            transition: all .25s;
        }
        .vc-btn-print {
            background: #10b981;
            color: #fff;
            box-shadow: 0 4px 12px rgba(16,185,129,.35);
        }
        .vc-btn-print:hover { background: #059669; color: #fff; transform: translateY(-1px); }
        .vc-btn-back {
            background: rgba(255,255,255,.1);
            color: #fff;
            border: 1px solid rgba(255,255,255,.2);
        }
        .vc-btn-back:hover { background: rgba(255,255,255,.2); color: #fff; }

        /* Page wrapper */
        .vc-page {
            display: flex;
            justify-content: center;
            padding: 32px 20px 60px;
        }

        /* Card shell (screen only) */
        .vc-card-shell {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 8px 40px rgba(0,0,0,.12);
            overflow: hidden;
            width: 720px;
            max-width: 100%;
        }
        .vc-card-shell-header {
            background: linear-gradient(135deg, #0f2040, #1e3a5f);
            padding: 14px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .vc-card-shell-header span {
            color: rgba(255,255,255,.7);
            font-size: .78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .vc-card-shell-header .vc-roll {
            background: #10b981;
            color: #fff;
            font-size: .78rem;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 50px;
        }
        .vc-card-body { padding: 24px; }

        /* ── Admit card content (shared screen + print) ── */
        table { border-collapse: collapse; }

        .admit-card {
            border: 1px solid #999;
            padding: 20px;
            width: 680px;
            max-width: 100%;
        }
        .table-gray td:nth-child(1) { background-color: lightgray; }
        .text-center { text-align: center; }
        .text-gray   { color: gray; }

        h1 {
            display: flex;
            align-items: center;
            margin: 0;
            text-align: center;
            font-size: 1.1rem;
        }
        .img-logo    { width: 55px; margin-right: 10px; }
        .common-text { text-align: center; font-size: 14px; margin-top: 0; margin-bottom: 6px; }
        .season      { text-align: center; margin-top: 0; margin-bottom: 5px; }
        .imp-text    { margin-top: 8px; margin-bottom: 3px; color: red; font-size: .88rem; }
        ol           { margin-top: 3px; padding-left: 15px; font-size: .85rem; }
        .sign        { width: 100px; }

        /* ── Print media ────────────────────────────────── */
        @@media print {
            .vc-toolbar    { display: none !important; }
            .vc-page       { padding: 0; background: none; }
            .vc-card-shell { box-shadow: none; border-radius: 0; width: auto; }
            .vc-card-shell-header { display: none; }
            .vc-card-body  { padding: 0; }
            body           { background: white; }
        }

        @@media (max-width: 600px) {
            .vc-toolbar-brand small { display: none; }
            .vc-btn span            { display: none; }
            .vc-btn                 { padding: 9px 14px; }
        }
    </style>
</head>
<body>

    <!-- Screen toolbar -->
    <div class="vc-toolbar">
        <div class="vc-toolbar-brand">
            <img src="/assets/img/logo.png" alt="ASNBB Logo" />
            <div>
                <span>ASNBB Admit Card</span>
                <small>Season 3 &nbsp;·&nbsp; 2026</small>
            </div>
        </div>
        <div class="vc-toolbar-actions">
            <a href="/AdmitCard" class="vc-btn vc-btn-back">
                <i class="bi bi-arrow-left"></i>
                <span>Back</span>
            </a>
            <button class="vc-btn vc-btn-print" onclick="window.print()">
                <i class="bi bi-printer-fill"></i>
                <span>Print / Save PDF</span>
            </button>
        </div>
    </div>

    <!-- Page body -->
    <div class="vc-page">
        <div class="vc-card-shell">

            <!-- Card shell header (screen only) -->
            <div class="vc-card-shell-header">
                <span><i class="bi bi-card-text me-1"></i> Official Admit Card</span>
                @if (!string.IsNullOrEmpty(Model.RollNumber))
                {
                    <span class="vc-roll">Roll No: @Model.RollNumber</span>
                }
            </div>

            <!-- Admit card content -->
            <div class="vc-card-body">
                <div class="admit-card">
                    <h1>
                        <img src="/assets/img/logo.png" class="img-logo" />
                        Allama Shibli Nomani Brainiac Battle
                    </h1>
                    <h2 class="season">Season - 2</h2>
                    <p class="common-text">Organized by - Team Brainiac Battle</p>
                    <p class="common-text">Sponsored by - M.I. Naseerul Uloom, Khutahna</p>
                    <p class="common-text">(Admit Card - 2026)</p>

                    <table class="table-gray" border="1" width="650" cellpadding="8">
                        <tr>
                            <td width="180">Name</td>
                            <td width="300" colspan="2">@Model.Name</td>
                        </tr>
                        <tr>
                            <td width="180">Roll Number</td>
                            <td width="300">@Model.RollNumber</td>
                            <td width="170" rowspan="4" class="text-gray text-center">
                                Please affix your passport size photograph here.
                            </td>
                        </tr>
                        <tr>
                            <td width="180">Father's Name</td>
                            <td width="300">@Model.FatherName</td>
                        </tr>
                        <tr>
                            <td width="180">Class</td>
                            <td width="300">@Model.Class</td>
                        </tr>
                        <tr>
                            <td width="180">School Name</td>
                            <td width="300">@Model.SchoolName</td>
                        </tr>
                    </table>

                    <table class="table-gray" border="1" width="650" cellpadding="8">
                        <tr>
                            <td colspan="3" class="text-center">EXAM DAY DETAILS</td>
                        </tr>
                        <tr>
                            <td width="180">Date and Day of Exam</td>
                            <td width="300">@Model.ExamDate</td>
                            <td width="170" rowspan="3"></td>
                        </tr>
                        <tr>
                            <td width="180">Exam Timing</td>
                            <td width="300">
                                @if (Model.ExamCentreId == 19)
                                {
                                    <span>11:30 AM to 01:30 PM</span>
                                }
                                else
                                {
                                    <span>10 AM to 12 PM</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td width="180">Center Code</td>
                            <td width="300">@Model.ExamCentreCode</td>
                        </tr>
                        <tr>
                            <td width="180">Exam Center</td>
                            <td width="300">@Model.ExamCentreName</td>
                            <td width="170" class="text-center text-gray">Student Sign</td>
                        </tr>
                    </table>

                    <table border="1" width="650" cellpadding="6">
                        <tr class="text-center">
                            <td width="325"><img class="sign" src="/assets/img/asad_sign.jpeg" /></td>
                            <td width="325"><img class="sign" src="/assets/img/ahmar_sign.jpeg" /></td>
                        </tr>
                        <tr class="text-center text-gray">
                            <td width="325">President Signature</td>
                            <td width="325">Examination Controller Signature</td>
                        </tr>
                    </table>

                    <h3 class="imp-text">Important Instructions for candidates:-</h3>
                    <ol>
                        <li>Candidate should report 30 minutes before examination time.</li>
                        <li>Candidate should bring their own blue/black ball pen for filling OMR sheets.</li>
                        <li>There will be negative mark of .25 on every wrong answer.</li>
                        <li>Candidate without a proper admit card and school ID card shall not be allowed in the examination.</li>
                        <li>Candidate shall not be allowed to leave the examination hall before the conclusion of examination.</li>
                        <li>Use of WHITE FLUID &amp; OVER WRITING/CUTTING on TEST BOOKLET and OMR SHEET is strictly prohibited.</li>
                        <li>Candidate must carry — i) ADMIT CARD &nbsp; ii) SCHOOL ID CARD &nbsp; iii) BALL POINT PEN (BLUE/BLACK)</li>
                    </ol>
                </div>
            </div>

        </div>
    </div>

</body>
</html>
